<Window x:Class="NtfsRecovery.Gui.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pré-visualização" Height="640" Width="760" WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="MetadataTextControl" Grid.Row="0" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                  TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" MaxHeight="140" Margin="0,0,0,8"/>

        <Grid Grid.Row="1">
            <Image x:Name="PreviewImageControl" Stretch="Uniform"/>
            <TextBox x:Name="PreviewTextControl" IsReadOnly="True" FontFamily="Consolas"
                      TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            <TextBlock x:Name="UnsupportedTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center"
                        FontSize="14" TextWrapping="Wrap" Margin="30" TextAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
