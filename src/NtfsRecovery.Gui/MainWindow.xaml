<Window x:Class="NtfsRecovery.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NtfsRecovery.Gui.ViewModels"
        xmlns:conv="clr-namespace:NtfsRecovery.Gui.Converters"
        Title="Dioscordes Recovery NFTS" Height="800" Width="1180" MinHeight="540" MinWidth="860">
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel Margin="8">
        <!-- Seleção da origem -->
        <GroupBox Header="Origem (somente leitura)" DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel Margin="6">
                <CheckBox Content="Usar disco físico em vez de arquivo de imagem" IsChecked="{Binding UseDisk}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,4">
                    <Button Content="Procurar..." Command="{Binding BrowseImageCommand}" DockPanel.Dock="Right" Width="90" Margin="6,0,0,0"/>
                    <TextBox x:Name="ImagePathTextBox" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseDisk, Converter={StaticResource InverseBool}}" AutomationProperties.AutomationId="ImagePathTextBox"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                    <Button Content="Listar discos" Command="{Binding ListDisksCommand}" IsEnabled="{Binding UseDisk}" DockPanel.Dock="Right" Width="120" Margin="6,0,0,0" AutomationProperties.AutomationId="ListDisksButton"/>
                    <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" IsEnabled="{Binding UseDisk}"
                              DisplayMemberPath="Display" HorizontalAlignment="Stretch" Margin="0,0,6,0" AutomationProperties.AutomationId="DisksComboBox"/>
                </DockPanel>
                <TextBox Text="{Binding DiskPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseDisk}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Partição:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                    <Button Content="Listar partições" Command="{Binding ListPartitionsCommand}" DockPanel.Dock="Right" Width="120" Margin="6,0,0,0" AutomationProperties.AutomationId="ListPartitionsButton"/>
                    <ComboBox ItemsSource="{Binding Partitions}" SelectedItem="{Binding SelectedPartition}"
                              DisplayMemberPath="Display" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="PartitionsComboBox"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="Offset da partição (bytes):" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                    <Button Content="Carregar informações do volume" Command="{Binding LoadVolumeCommand}" DockPanel.Dock="Right" Width="200" Margin="6,0,0,0" AutomationProperties.AutomationId="LoadVolumeButton"/>
                    <TextBox Text="{Binding PartitionOffsetText, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock Text="{Binding VolumeInfoText}" Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="Consolas" AutomationProperties.AutomationId="VolumeInfoText"/>
            </StackPanel>
        </GroupBox>

        <!-- Controles de varredura -->
        <GroupBox Header="Varredura" DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel Margin="6">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Banco de dados da varredura (salvo automaticamente durante a execução):" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                    <Button Content="Procurar..." Command="{Binding BrowseScanDbCommand}" DockPanel.Dock="Right" Width="90" Margin="6,0,0,0"/>
                    <Button Content="Carregar do BD (sem varrer)" Command="{Binding LoadFromDatabaseCommand}" DockPanel.Dock="Right" Width="180" Margin="6,0,0,0" AutomationProperties.AutomationId="LoadFromDatabaseButton"/>
                    <TextBox Text="{Binding ScanDbPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ScanDbPathTextBox"/>
                </DockPanel>

                <Expander Header="Opções avançadas (offset/tamanho parcial, tamanho do bloco, retomar)" Margin="0,0,0,4">
                    <StackPanel Margin="0,6,0,0">
                        <WrapPanel Margin="0,0,0,4">
                            <TextBlock Text="Offset inicial (bytes, vazio = offset da partição):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding StartOffsetText, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,16,0"/>
                            <TextBlock Text="Tamanho a escanear (bytes, vazio = resto do volume):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding LengthText, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Tamanho do bloco de leitura (bytes):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding BlockSizeText, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,16,0"/>
                            <CheckBox Content="Retomar do último checkpoint salvo no banco de dados" IsChecked="{Binding ResumeScan}" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Escanear" Command="{Binding ScanCommand}" Width="90" Margin="0,0,6,0" AutomationProperties.AutomationId="ScanButton"/>
                    <Button Content="Cancelar" Command="{Binding CancelScanCommand}" Width="90"/>
                </StackPanel>
                <ProgressBar Value="{Binding ScanProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="18" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding ScanStatusText}" TextWrapping="Wrap" FontFamily="Consolas" AutomationProperties.AutomationId="ScanStatusText"/>
            </StackPanel>
        </GroupBox>

        <!-- Log -->
        <GroupBox Header="Log" DockPanel.Dock="Bottom" Height="140" Margin="0,6,0,0">
            <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="11"/>
        </GroupBox>

        <!-- Conteúdo principal: árvore + lista de arquivos/preview/recuperação -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Pastas" Grid.Column="0" Margin="0,0,6,0">
                <TreeView x:Name="FoldersTreeView" ItemsSource="{Binding RootItems}" SelectedItemChanged="TreeView_SelectedItemChanged" AutomationProperties.AutomationId="FoldersTreeView"/>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Conteúdo (duplo clique num arquivo para pré-visualizar)" Grid.Row="0" Margin="0,0,0,6">
                    <DataGrid ItemsSource="{Binding FileListItems}" SelectedItem="{Binding SelectedFileItem}"
                              AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="ContentsDataGrid"
                              MouseDoubleClick="ContentsDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Registro" Binding="{Binding Record}" Width="80"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="80"/>
                            <DataGridTextColumn Header="Runs" Binding="{Binding Runs}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Recuperar pasta/arquivo selecionado" Grid.Row="1">
                    <DockPanel Margin="6">
                        <Button Content="Recuperar" Command="{Binding RecoverSelectedCommand}" DockPanel.Dock="Right" Width="100" Margin="6,0,0,0"/>
                        <Button Content="Procurar..." Command="{Binding BrowseDestinationCommand}" DockPanel.Dock="Right" Width="90" Margin="6,0,0,0"/>
                        <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
